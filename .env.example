# ─── Google Gen AI ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─── Telegram API ─────────────────────────────────────────────────────────────
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_FILE=telegram_session

# ─── Storage & Database ───────────────────────────────────────────────────────
STORAGE_DIR=./storage/stickers
CHROMA_PERSIST_DIR=./chroma_db

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Delay in seconds between embedding batches (default 2s → safely under 3000 RPM)
EMBEDDING_BATCH_DELAY_S=2.0

# ─── Translation Cache ────────────────────────────────────────────────────────
# Set to true and install `redis` package to enable Redis-backed caching
USE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379
