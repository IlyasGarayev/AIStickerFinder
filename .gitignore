# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
*.env.local

# ─── Telegram Session ─────────────────────────────────────────────────────────
telegram_session.session
telegram_session.session-journal
*.session
*.session-journal

# ─── ChromaDB (vector store data) ────────────────────────────────────────────
chroma_db/

